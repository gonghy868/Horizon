{
  "ai": {
    "provider": "openai",
    "model": "deepseek-chat",
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "https://api.deepseek.com/v1",
    "temperature": 0.3,
    "languages": ["zh", "en"]
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "gonghy868",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "NousResearch",
        "repo": "hermes-agent",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "Ultralytics",
        "repo": "ultralytics",
        "enabled": true
      }
    ],
    "hackernews": { "enabled": true, "fetch_top_stories": 30, "min_score": 50 },
    "rss": [
      { "name": "OpenAI Blog", "url": "https://openai.com/blog/rss.xml", "enabled": true, "category": "ai" },
      { "name": "HN RSS", "url": "https://news.ycombinator.com/rss", "enabled": true, "category": "tech" },
      { "name": "ML Reddit", "url": "https://reddit.com/r/MachineLearning/.rss", "enabled": true, "category": "ai" }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        { "subreddit": "artificial", "enabled": true, "sort": "hot", "fetch_limit": 10, "min_score": 5 },
        { "subreddit": "MachineLearning", "enabled": true, "sort": "hot", "fetch_limit": 10, "min_score": 5 },
        { "subreddit": "LocalLLaMA", "enabled": true, "sort": "hot", "fetch_limit": 10, "min_score": 5 }
      ],
      "fetch_comments": 3
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python"],
      "keywords": [],
      "min_stars": 10,
      "max_items": 20
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 48,
    "max_items": 20
  }
}
